<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:gravity="center"
    android:background="@drawable/bg_gradient_neon">

    <!-- Logo / Circle -->
    <LinearLayout
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/logo_circle"
        android:elevation="8dp">

        <ImageView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="App logo" />
    </LinearLayout>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENGINEERING QUIZ"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"
        android:layout_marginTop="18dp"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Upload a CSV of 200 questions and start a 30-question quiz"
        android:textColor="#CFCFCF"
        android:textSize="13sp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:paddingLeft="18dp"
        android:paddingRight="18dp" />

    <!-- Upload button -->
    <Button
        android:id="@+id/uploadCsvBtn"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="Upload Questions (CSV)"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="30dp"
        android:background="@drawable/btn_neon"
        android:elevation="8dp" />

    <!-- Start button -->
    <Button
        android:id="@+id/startQuizBtn"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:text="Start Quiz"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:layout_marginTop="18dp"
        android:background="@drawable/btn_primary"
        android:elevation="10dp" />

    <!-- small footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tip: CSV must have header row (question,optionA,optionB,optionC,optionD,correct)"
        android:textColor="#999999"
        android:textSize="11sp"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:paddingLeft="14dp"
        android:paddingRight="14dp" />

</LinearLayout>
