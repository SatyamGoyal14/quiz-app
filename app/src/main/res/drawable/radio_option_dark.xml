<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected option (Glow + Blue BG) -->
    <item android:state_checked="true">
        <shape>
            <solid android:color="#1D4ED8"/>
            <corners android:radius="12dp"/>
            <stroke android:width="2dp" android:color="#60A5FA"/>
            <padding android:top="14dp" android:bottom="14dp" android:left="12dp" android:right="12dp"/>
        </shape>
    </item>

    <!-- Unselected option (dark card) -->
    <item>
        <shape>
            <solid android:color="#1A1A1A"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#333333"/>
            <padding android:top="14dp" android:bottom="14dp" android:left="12dp" android:right="12dp"/>
        </shape>
    </item>

</selector>
