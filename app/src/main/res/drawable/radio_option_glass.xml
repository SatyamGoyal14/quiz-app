<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape>
            <gradient android:startColor="#164E63" android:endColor="#0EA5E9" android:angle="90"/>
            <corners android:radius="12dp"/>
            <padding android:left="12dp" android:right="12dp" android:top="12dp" android:bottom="12dp"/>
            <stroke android:width="2dp" android:color="#60A5FA"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#151823"/>
            <corners android:radius="12dp"/>
            <stroke android:width="1dp" android:color="#2B3440"/>
            <padding android:left="12dp" android:right="12dp" android:top="12dp" android:bottom="12dp"/>
        </shape>
    </item>
</selector>
